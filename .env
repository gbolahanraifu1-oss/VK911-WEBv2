# VK911 XMD Web Dashboard — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your real .env to GitHub

# PostgreSQL connection string (Neon or Supabase)
# Get a free DB at: https://neon.tech or https://supabase.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Session security — generate a random string (e.g. openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-64-char-string

# URL of your bot API server (running on your VPS/panel)
BOT_API_URL=http://YOUR_VPS_IP:3001

# Optional: Secret key to authenticate web → bot API calls
BOT_API_SECRET=your-shared-secret-here